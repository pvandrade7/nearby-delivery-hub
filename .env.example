# Copie este arquivo para .env e preencha com suas credenciais.
# Nunca commite o arquivo .env — ele já está no .gitignore.

# ── Supabase — Project Settings → API ──────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Pagamentos (configurar nas Edge Functions do Supabase) ─
# Defina estas variáveis em: Supabase Dashboard → Edge Functions → Secrets
#
# Gateway selecionado:
#   "simulation"   → sem cobrança real (padrão para desenvolvimento)
#   "mercadopago"  → Mercado Pago (recomendado para produção no Brasil)
#   "asaas"        → Asaas
PAYMENT_GATEWAY=simulation

# Token do gateway escolhido:
#   Mercado Pago → Dashboard MP → Credenciais → Access Token de PRODUÇÃO
#   Asaas        → Minha Conta → Integrações → Chave de API
PAYMENT_GATEWAY_TOKEN=

# Secret para verificar assinatura dos webhooks (opcional mas recomendado):
#   Mercado Pago → Dashboard MP → Webhooks → Secret
#   Asaas        → não utiliza assinatura
PAYMENT_WEBHOOK_SECRET=

# ── URL do webhook (configure no painel do gateway) ────
# https://<seu-projeto>.supabase.co/functions/v1/payment-webhook
